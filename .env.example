# Copie ce fichier en `.env` et renseigne les valeurs après avoir créé le projet Sanity.
#
# Après `npx sanity@latest init` :
PUBLIC_SANITY_PROJECT_ID=        # ex: a1b2c3d4  (Sanity manage → projet → Project ID)
PUBLIC_SANITY_DATASET=production # le dataset (par défaut « production »)

# Token d'écriture (Sanity manage → API → Tokens, rôle Editor).
# Sert UNIQUEMENT au script de seed (npm run sanity:seed). Ne jamais committer.
SANITY_WRITE_TOKEN=
