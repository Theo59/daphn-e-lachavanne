---
import Layout from '../layouts/Layout.astro';
import Sym from '../components/Sym.astro';
import { legal } from '../i18n/legal';

// En statique Astro ne sert qu'un seul /404.html (pas de /en/404).
// On rend donc la page bilingue : FR puis l'équivalent EN.
const fr = legal.fr.notFound;
const en = legal.en.notFound;

// Liens de navigation : libellé FR + EN, vers les chemins FR canoniques.
const navLinks = fr.links.map((l, i) => ({
  path: l.path,
  fr: l.label,
  en: en.links[i].label,
}));
---

<Layout
  activePage=""
  title={fr.meta.title}
  description={fr.meta.description}
>
  <section class="section section--top" style="min-height:62vh;display:flex;align-items:center">
    <div class="container">
      <div class="grid-2" style="align-items:center">
        <div>
          <span class="t-label">{fr.label} · {en.label}</span>
          <h1 style="font-family:'Tenor Sans',serif;font-size:clamp(64px,11vw,140px);line-height:0.9;font-weight:400;letter-spacing:-0.02em;margin:18px 0 0">
            {fr.titleLine1}<br /><em style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:300">{fr.titleLine2}</em>
          </h1>
          <p style="font-size:16px;line-height:1.8;color:var(--muted);max-width:42ch;margin-top:26px">
            {fr.body}
          </p>
          <p style="font-size:15px;line-height:1.8;color:var(--muted);max-width:42ch;margin-top:12px;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:18px">
            {en.body}
          </p>
          <div style="margin-top:34px">
            <a href="/" class="btn btn--dark">{fr.backHome} · {en.backHome} <Sym kind="arrow" size={16} /></a>
          </div>
        </div>

        <nav aria-label={`${fr.navAria} · ${en.navAria}`} style="border-top:1px solid var(--rule)">
          {navLinks.map((l) => (
            <a
              href={l.path}
              style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;border-bottom:1px solid var(--rule);text-decoration:none;font-family:'Tenor Sans',serif;font-size:clamp(20px,2.4vw,28px);color:var(--ink)"
            >
              <span>{l.fr} <span style="color:var(--muted);font-size:0.6em;letter-spacing:0.12em;text-transform:uppercase">{l.en}</span></span>
              <Sym kind="arrow" size={18} />
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>
</Layout>
