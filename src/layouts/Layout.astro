---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import { getSettings, getBrandColors } from '../lib/sanity/content';
import { OG_LOCALE, HTML_LANG, DEFAULT_LOCALE } from '../i18n/config';
import { getLangFromUrl, getAlternates } from '../i18n/utils';
import { urlFor, hasImage } from '../lib/sanity/image';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  darkNav?: boolean;
  noFooter?: boolean;
  /** Image de partage social (chemin absolu sous /). 1200×630 recommandé. */
  image?: string;
}

// Langue dérivée de l'URL (/en/... → 'en', sinon 'fr').
const lang = getLangFromUrl(Astro.url);
const c = await getSettings(lang);
// Couleurs de marque éditables dans Sanity → surchargent --blue/--orange de :root.
const brandColors = await getBrandColors();

const {
  title = c.siteName,
  description = c.schema.businessDescription,
  activePage = 'home',
  darkNav = false,
  noFooter = false,
  image = '/og-image.jpg',
} = Astro.props;

// URL canonique de la page courante, dérivée de `site` (astro.config.mjs).
// Normalise les URLs en `build.format: 'file'` (/soins.html → /soins, /index.html → /).
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/$/, '');
const canonical = new URL(cleanPath || '/', Astro.site).href.replace(/\/$/, '') || Astro.site?.href;
const ogImage = new URL(image, Astro.site).href;
const siteName = c.siteName;

// Liens alternés (hreflang) : chaque langue + x-default (= FR par défaut).
const alternates = getAlternates(Astro.url).map((alt) => ({
  ...alt,
  href: new URL(alt.path, Astro.site).href.replace(/\/$/, '') || Astro.site?.href,
}));
const xDefaultHref = alternates.find((a) => a.lang === DEFAULT_LOCALE)?.href;

// Base sans slash final pour les @id de données structurées.
const base = (Astro.site?.href ?? 'https://daphnelachavanne.netlify.app/').replace(/\/$/, '');

// Logo + portrait (JSON-LD) depuis les visuels de marque Sanity ; og-image reste local.
const brand = (c as any).brand ?? {};
const logoUrl = hasImage(brand.logo) ? urlFor(brand.logo).width(600).url() : `${base}/og-image.jpg`;
const portraitUrl = hasImage(brand.portrait) ? urlFor(brand.portrait).width(800).url() : `${base}/og-image.jpg`;

// JSON-LD global (GEO/AEO) : entreprise locale + praticienne + site.
// Volontairement SANS aggregateRating/téléphone (non vérifiables → risque de pénalité).
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'HealthAndBeautyBusiness'],
      '@id': `${base}/#business`,
      name: 'Daphné Lachavanne · L’Art de la Circulation',
      alternateName: 'Daphné Lachavanne',
      description: c.schema.businessDescription,
      url: base,
      image: `${base}/og-image.jpg`,
      logo: logoUrl,
      email: 'hello@daphnelachavanne.com',
      priceRange: '60-780 €',
      currenciesAccepted: 'EUR',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '3 Rue Valadon',
        postalCode: '75007',
        addressLocality: 'Paris',
        addressRegion: 'Île-de-France',
        addressCountry: 'FR',
      },
      // Coordonnées exactes du 3 Rue Valadon (géocodage officiel BAN, data.gouv.fr).
      geo: { '@type': 'GeoCoordinates', latitude: 48.857303, longitude: 2.305538 },
      areaServed: { '@type': 'City', name: 'Paris' },
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '15:00', closes: '22:30' },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '08:00',
          closes: '22:30',
        },
      ],
      hasMap: 'https://maps.google.com/?q=3+Rue+Valadon+75007+Paris',
      sameAs: ['https://www.planity.com/daphne-lachavanne-75007-paris'],
      founder: { '@id': `${base}/#daphne` },
      employee: { '@id': `${base}/#daphne` },
      knowsAbout: [
        'Drainage lymphatique',
        'Méthode Renata França',
        'Yoga',
        'Breathwork',
        'Cohérence cardiaque',
        'Pilates',
        'Soin énergétique',
      ],
    },
    {
      '@type': 'Person',
      '@id': `${base}/#daphne`,
      name: 'Daphné Lachavanne',
      jobTitle: c.schema.personJobTitle,
      worksFor: { '@id': `${base}/#business` },
      url: `${base}/about`,
      image: portraitUrl,
      knowsAbout: ['Drainage lymphatique', 'Méthode Renata França', 'Yoga', 'Breathwork', 'Pilates', 'Reiki'],
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'Méthode Renata França, drainage lymphatique', dateCreated: '2013' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'Formation yoga 200h', dateCreated: '2017' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'Breathwork holotropique', dateCreated: '2019' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'Reiki & magnétisme', dateCreated: '2022' },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${base}/#website`,
      url: base,
      name: 'Daphné Lachavanne',
      inLanguage: HTML_LANG[lang],
      publisher: { '@id': `${base}/#business` },
    },
  ],
};

// Fil d'Ariane (BreadcrumbList) pour les pages internes, libellés localisés.
const navLinks = c.nav.links as Record<string, string>;
if (activePage !== 'home' && navLinks[activePage]) {
  structuredData['@graph'].push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: c.breadcrumbHome, item: lang === DEFAULT_LOCALE ? base : `${base}/${lang}` },
      { '@type': 'ListItem', position: 2, name: navLinks[activePage], item: canonical },
    ],
  } as any);
}
---

<!doctype html>
<html lang={HTML_LANG[lang]} style={`--blue:${brandColors.blue};--orange:${brandColors.orange}`}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- Versions linguistiques alternées (hreflang) -->
  {alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.htmlLang} href={alt.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Polices auto-hébergées (déclarées dans global.css). Préchargement des
       deux fontes critiques pour le LCP : titres Tenor Sans + corps Inter. -->
  <link rel="preload" href="/fonts/tenor-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Données structurées globales : entreprise locale + praticienne -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body>
  <a href="#content" class="skip-link">{c.skipLink}</a>
  <AnnouncementBar a={(c as any).announcement} />
  <Nav active={activePage} dark={darkNav} />
  <main id="content" tabindex="-1">
    <slot />
  </main>
  {!noFooter && <Footer />}
  <NewsletterPopup />
  <script>
    import '../scripts/animations.ts';
  </script>
</body>
</html>
