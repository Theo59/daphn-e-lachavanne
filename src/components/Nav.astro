---
import Logo from './Logo.astro';
import { getSettings } from '../lib/sanity/content';
import { LOCALES, LANG_LABELS, LANG_NAMES } from '../i18n/config';
import { getLangFromUrl, getAlternates, localizePath } from '../i18n/utils';

interface Props {
  active?: string;
  dark?: boolean;
}

const { active = 'home', dark = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const c = await getSettings(lang);

// [chemin canonique FR, clé de page] — la clé sert au libellé + à l'état actif.
const routes: [string, string][] = [
  ['/', 'home'],
  ['/soins', 'soins'],
  ['/yoga', 'yoga'],
  ['/breathwork', 'breathwork'],
  ['/pilates', 'pilates'],
  ['/about', 'about'],
  ['/contact', 'contact'],
];
const links = c.nav.links as Record<string, string>;
const items = routes.map(([path, key]) => ({
  href: localizePath(path, lang),
  key,
  label: links[key],
}));

// Sélecteur de langue : chemin équivalent dans chaque langue.
const alternates = getAlternates(Astro.url);
const ctaHref = localizePath('/contact', lang);
---

<nav class:list={['nav', dark ? 'nav--hero' : 'nav--light']} id="main-nav" aria-label={c.nav.ariaLabel}>
  <a href={localizePath('/', lang)} class="nav__logo" aria-label={c.nav.logoAria}>
    <Logo size={16} />
  </a>

  <ul class="nav__links" role="list">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['nav__link', active === item.key && 'nav__link--active']}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>

  <div class="nav__actions">
    <div class="nav__lang" role="group" aria-label={c.nav.langAria}>
      {alternates.map((alt) => (
        alt.lang === lang
          ? <span class="nav__lang-item nav__lang-item--active" aria-current="true">{LANG_LABELS[alt.lang]}</span>
          : <a class="nav__lang-item" href={alt.path} hreflang={alt.htmlLang} aria-label={LANG_NAMES[alt.lang]}>{LANG_LABELS[alt.lang]}</a>
      ))}
    </div>
    <a href={ctaHref} class="nav__cta">{c.nav.cta}</a>
  </div>

  <button class="nav__hamburger" id="hamburger-btn" aria-label={c.nav.menuOpen} aria-expanded="false" aria-controls="mobile-menu">
    <span></span><span></span>
  </button>
</nav>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label={c.nav.menuAria} aria-hidden="true">
  <button class="mobile-menu__close" id="mobile-close" aria-label={c.nav.menuClose}>✕</button>
  <nav>
    <ul class="mobile-menu__list" role="list">
      {items.map((item) => (
        <li>
          <a href={item.href} class="mobile-menu__link">{item.label}</a>
        </li>
      ))}
    </ul>
    <div class="mobile-menu__lang" role="group" aria-label={c.nav.langAria}>
      {alternates.map((alt) => (
        alt.lang === lang
          ? <span class="mobile-menu__lang-item mobile-menu__lang-item--active" aria-current="true">{LANG_NAMES[alt.lang]}</span>
          : <a class="mobile-menu__lang-item" href={alt.path} hreflang={alt.htmlLang}>{LANG_NAMES[alt.lang]}</a>
      ))}
    </div>
  </nav>
</div>

<script>
  const nav       = document.getElementById('main-nav')!;
  const hamburger = document.getElementById('hamburger-btn')!;
  const menu      = document.getElementById('mobile-menu')!;
  const closeBtn  = document.getElementById('mobile-close')!;

  function openMenu() {
    menu.classList.add('is-open');
    menu.setAttribute('aria-hidden', 'false');
    hamburger.setAttribute('aria-expanded', 'true');
    document.body.classList.add('menu-open');
  }

  function closeMenu() {
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
    hamburger.focus();
  }

  hamburger.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);

  menu.querySelectorAll('.mobile-menu__link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && menu.classList.contains('is-open')) closeMenu();
  });
</script>
