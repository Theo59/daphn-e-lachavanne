---
/**
 * Bloc de prose éditoriale, texte riche et crawlable (SEO/GEO).
 * `text` : texte enrichi (Portable Text Sanity) ou chaîne fallback du dico
 * (paragraphes séparés par une ligne vide). Chaque bloc/paragraphe → un <p>.
 * Mise en page éditoriale : label en colonne latérale, paragraphe d'accroche
 * mis en avant + lettrine, reste du texte en colonne lisible (~62ch).
 * Tout le texte reste dans le DOM (aucune coupe), pour ne pas régresser le SEO.
 */
import { richTextToParagraphs } from '../lib/sanity/richText';
interface Props {
  text: unknown; // string (fallback dico) | Portable Text (Sanity)
  label?: string;
  flush?: boolean; // true = pas de padding section (utilisé dans une section existante)
}
const { text, label, flush = false } = Astro.props;
// 1 bloc = 1 paragraphe ; italique/gras/lien préservés en HTML inline.
const paragraphs = richTextToParagraphs(text);
const [lead, ...rest] = paragraphs;
---

<section class={flush ? 'prose-block' : 'section prose-block'}>
  <div class="container">
    <div class="prose-grid">
      <aside class="prose-aside">
        {label && <h2 class="t-label">( {label} )</h2>}
      </aside>
      <div class="prose-body">
        {lead && <p class="prose-lead" set:html={lead} />}
        {rest.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </div>
</section>

<style>
  /* Section allégée : padding vertical réduit + typo compacte.
     Le texte reste 100% visible et dans le DOM → valeur SEO/GEO intacte. */
  .section.prose-block { padding-top: 4rem; padding-bottom: 4rem; }

  /* Grille label/contenu (1fr / 2fr). */
  .prose-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    align-items: start;
  }
  .prose-aside {
    position: sticky;
    top: 100px;
  }
  .prose-aside .t-label { margin: 0; }

  .prose-body { max-width: 62ch; overflow-wrap: break-word; }

  /* Paragraphe d'accroche : plus grand, encré, avec lettrine Cormorant. */
  .prose-lead {
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.85;
    color: var(--ink);
    margin: 0 0 1.1em;
  }
  .prose-lead::first-letter {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 2.3em;
    line-height: 0.82;
    float: left;
    padding: 0.06em 0.12em 0 0;
    color: var(--orange);
  }

  /* Texte de fond : mesure courte, gris brand, rythme aéré. */
  .prose-body p:not(.prose-lead) {
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    margin: 0 0 0.9em;
  }
  .prose-body p:last-child { margin-bottom: 0; }

  @media (max-width: 900px) {
    .prose-grid { grid-template-columns: 1fr; gap: 24px; }
    .prose-aside { position: static; }
    .prose-body { max-width: none; }
  }
</style>
