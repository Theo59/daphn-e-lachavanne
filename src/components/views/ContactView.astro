---
/**
 * Vue partagée de la page Contact / réservation. Rendue pour `/contact` (FR) et
 * `/en/contact` (EN). Tout le texte vient de src/i18n/contact.ts (+ common.ts).
 * Le formulaire poste en natif (POST classique, sans JS) vers /api/contact,
 * qui envoie le message via Brevo puis redirige vers la valeur du champ caché
 * "redirect" (localisée FR/EN) pour afficher la confirmation.
 * Styles : classes scopées (<style>) ; fond du bloc réservation dynamique → inline.
 */
import Layout from '../../layouts/Layout.astro';
import Prose from '../Prose.astro';
import Faq from '../Faq.astro';
import { getPageContent, getSettings } from '../../lib/sanity/content';
import { PLANITY } from '../../lib/views';
import { localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getPageContent('contact', lang);
const c = await getSettings(lang);
---

<Layout activePage="contact" title={t.meta.title} description={t.meta.description}>

  <div class="page-header container rel-clip">
    <span class="t-label">{t.header.label}</span>
    <h1>
      {t.header.titleLine1}<br /><em class="t-corm">{t.header.titleLine2}</em>
    </h1>
  </div>

  <section class="section pt0">
    <div class="container">
      <div class="grid-2">

        <div>
          <h2 class="t-label col-label">{t.form.label}</h2>

          <div id="contact-success" class="form-success" hidden role="status">
            <p class="form-success__title">{t.form.successTitle}</p>
            <p class="form-success__text">{t.form.successText}</p>
          </div>

          <form class="form-group" name="contact" method="POST" action="/api/contact">
            <input type="hidden" name="redirect" value={localizePath('/contact', lang) + '?ok=1'} />
            <p hidden aria-hidden="true">
              <label>{t.form.honeypot} <input name="bot-field" /></label>
            </p>
            <div class="form-row">
              <div class="form-field">
                <label class="form-field__label" for="f-prenom">{t.form.prenomLabel}</label>
                <input id="f-prenom" type="text" name="prenom" placeholder={t.form.prenomPlaceholder} autocomplete="given-name" required />
              </div>
              <div class="form-field">
                <label class="form-field__label" for="f-nom">{t.form.nomLabel}</label>
                <input id="f-nom" type="text" name="nom" placeholder={t.form.nomPlaceholder} autocomplete="family-name" />
              </div>
            </div>
            <div class="form-field">
              <label class="form-field__label" for="f-email">{t.form.emailLabel}</label>
              <input id="f-email" type="email" name="email" placeholder={t.form.emailPlaceholder} autocomplete="email" required />
            </div>
            <div class="form-field">
              <label class="form-field__label" for="f-pratique">{t.form.pratiqueLabel}</label>
              <input id="f-pratique" type="text" name="pratique" placeholder={t.form.pratiquePlaceholder} />
            </div>
            <div class="form-field">
              <label class="form-field__label" for="f-message">{t.form.messageLabel}</label>
              <textarea id="f-message" name="message" rows="4" placeholder={t.form.messagePlaceholder}></textarea>
            </div>
            <div>
              <button type="submit" class="btn btn--dark">{t.form.submit}</button>
            </div>
          </form>
        </div>

        <div>
          <h2 class="t-label col-label">{t.booking.label}</h2>

          <div class="booking" style={`background:var(--${t.booking.bgColor === 'orange' ? 'orange' : 'blue'})`}>
            <div class="booking__inner">
              <span class="booking__eyebrow">{t.booking.eyebrow}</span>
              <h3 class="booking__title">{t.booking.title}</h3>
              <p class="booking__text">{t.booking.text}</p>
              <a href={PLANITY} target="_blank" rel="noopener" class="btn btn--outline-white booking__cta" data-umami-event="book_click" data-umami-event-location="contact_booking">
                {c.cta.bookPlanity} →
              </a>
            </div>
          </div>

          <h2 class="t-label col-label--tight">{t.cabinet.label}</h2>
          <address class="address">
            <p class="address__name">
              {t.cabinet.addressLine1}<br />{t.cabinet.addressLine2}
            </p>
            <p class="address__detail">
              {t.cabinet.email}<br /><br />
              {t.cabinet.hours1}<br />
              {t.cabinet.hours2}<br />
              {t.cabinet.hours3}
            </p>
          </address>
        </div>

      </div>
    </div>
  </section>

  <section class="section--sm pt0">
    <div class="container">
      <div class="map-placeholder">
        <div id="cabinet-map" class="map__canvas" role="img" aria-label={t.map.label + ' — ' + t.map.address}></div>
        <div class="map__card">
          <span class="t-label map__card-label">{t.map.label}</span>
          <span class="map__card-addr">{t.map.address}</span>
        </div>
      </div>
    </div>
  </section>

  <Faq items={t.faqs} title={c.faqTitle} />

  <Prose text={t.prose.text} label={t.prose.label} />

</Layout>

<style>
  /* Utilitaires communs (.rel-clip, .pt0) → src/styles/views.css */
  .col-label { margin-bottom: 28px; }
  .col-label--tight { margin-bottom: 20px; }

  /* Bloc réservation (fond dynamique → inline) */
  .booking { position: relative; border-radius: 6px; overflow: hidden; min-height: 220px; margin-bottom: 36px; }
  .booking__inner { position: relative; padding: 32px; color: #fff; }
  .booking__eyebrow {
    font-family: 'Tenor Sans', serif; font-size: 10px; letter-spacing: 0.2em;
    text-transform: uppercase; opacity: 0.85;
  }
  .booking__title { font-family: 'Tenor Sans', serif; font-size: 34px; line-height: 1; margin: 10px 0 14px; font-weight: 400; }
  .booking__text { font-size: 14px; line-height: 1.85; opacity: 0.92; margin: 0; max-width: 340px; }
  .booking__cta { margin-top: 22px; }

  /* Adresse */
  .address { font-style: normal; }
  .address__name { font-family: 'Tenor Sans', serif; font-size: 22px; line-height: 1.4; margin: 0 0 14px; font-weight: 400; }
  .address__detail { font-size: 13.5px; line-height: 1.85; color: var(--muted); margin: 0; }

  /* Carte */
  .map__canvas { position: absolute; inset: 0; }
  .map__card {
    position: absolute; z-index: 1000; bottom: 20px; left: 20px; background: #fff;
    padding: 12px 18px; border-radius: 4px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  .map__card-label { display: block; margin-bottom: 4px; }
  .map__card-addr { font-family: 'Tenor Sans', serif; font-size: 15px; }

  /* Confirmation d'envoi du formulaire */
  .form-success {
    border-left: 2px solid var(--orange);
    background: rgba(255,113,0,0.06);
    padding: 22px 24px;
    border-radius: 0 4px 4px 0;
    margin-bottom: 8px;
    animation: pageIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .form-success__title {
    font-family: 'Tenor Sans', serif;
    font-size: 19px;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .form-success__text {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
    max-width: 44ch;
  }
</style>

<script is:inline>
  // /api/contact redirige vers ?ok=1 après envoi : on confirme et on masque le formulaire.
  if (new URLSearchParams(location.search).get('ok')) {
    const banner = document.getElementById('contact-success');
    const form = document.querySelector('form[name="contact"]');
    if (banner) {
      banner.hidden = false;
      banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    if (form) form.hidden = true;
    if (typeof umami !== 'undefined') umami.track('contact_form_submit');
  }
</script>

<script>
  // Carte du cabinet : Leaflet + tuiles CARTO Positron (minimal, clair).
  // Arrêts de transport à proximité mis en évidence en orange (données OpenStreetMap, figées).
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const CABINET: [number, number] = [48.857303, 2.305538];
  const METRO: { n: string; s: string; c: [number, number] }[] = [
    { n: 'École Militaire', s: 'Métro 8', c: [48.8546647, 2.3060728] },
    { n: 'La Tour-Maubourg', s: 'Métro 8', c: [48.8575602, 2.3103234] },
  ];
  const BUS: { n: string; c: [number, number] }[] = [
    { n: 'Bosquet - Grenelle', c: [48.8567350, 2.3043968] },
    { n: 'Bosquet - Saint-Dominique', c: [48.8584313, 2.3035608] },
    { n: 'Champ de Mars - La Bourdonnais', c: [48.8565257, 2.3020405] },
    { n: 'Invalides - La Tour-Maubourg', c: [48.8568059, 2.3093976] },
    { n: 'Rue Cler', c: [48.8556204, 2.3073399] },
    { n: 'Saint-Pierre du Gros Caillou', c: [48.8578051, 2.3062945] },
    { n: 'École Militaire', c: [48.8548656, 2.3055095] },
  ];

  const el = document.getElementById('cabinet-map');
  if (el) {
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 20,
    }).addTo(map);

    // Bus : petits points orange.
    BUS.forEach((b) => {
      L.circleMarker(b.c, { radius: 5, weight: 1.5, color: '#fff', fillColor: '#ff7100', fillOpacity: 0.9 })
        .addTo(map)
        .bindTooltip(`Bus · ${b.n}`, { direction: 'top' });
    });

    // Métro : badge « M » orange (mis en évidence).
    const metroIcon = L.divIcon({
      className: '',
      html:
        '<div style="width:26px;height:26px;border-radius:50%;background:#ff7100;color:#fff;border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,0.25);display:flex;align-items:center;justify-content:center;font-family:\'Tenor Sans\',serif;font-size:14px;line-height:1">M</div>',
      iconSize: [26, 26],
      iconAnchor: [13, 13],
    });
    METRO.forEach((m) => {
      L.marker(m.c, { icon: metroIcon })
        .addTo(map)
        .bindTooltip(`${m.n} · ${m.s}`, { direction: 'top' });
    });

    // Cabinet : point bleu + halo orange (le plus visible, distinct des arrêts).
    L.circleMarker(CABINET, { radius: 22, weight: 0, fillColor: '#ff7100', fillOpacity: 0.16 }).addTo(map);
    L.circleMarker(CABINET, { radius: 9, weight: 3, color: '#fff', fillColor: '#16066e', fillOpacity: 1 })
      .addTo(map)
      .bindTooltip('Le cabinet · 3 Rue Valadon', { direction: 'top' });

    // Cadrage auto : cabinet + tous les arrêts.
    const all: [number, number][] = [CABINET, ...METRO.map((m) => m.c), ...BUS.map((b) => b.c)];
    map.fitBounds(all, { padding: [34, 34], maxZoom: 16 });
  }
</script>
