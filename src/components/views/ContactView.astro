---
/**
 * Vue partagée de la page Contact / réservation. Rendue pour `/contact` (FR) et
 * `/en/contact` (EN). Tout le texte vient de src/i18n/contact.ts (+ common.ts).
 * Le formulaire Netlify reste un endpoint unique (name="contact", form-name,
 * honeypot) ; seule l'action est localisée pour le retour ?ok=1.
 */
import Layout from '../../layouts/Layout.astro';
import SanityImage from '../SanityImage.astro';
import Prose from '../Prose.astro';
import Faq from '../Faq.astro';
import { getPageContent, getSettings } from '../../lib/sanity/content';
import { urlFor, hasImage } from '../../lib/sanity/image';
import { localizePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getPageContent('contact', lang);
const c = await getSettings(lang);

const PLANITY = 'https://www.planity.com/daphne-lachavanne-75007-paris';

// Visuels de marque partagés (fonds, décor) — groupe `brand` des réglages.
const brand = (c as any).brand ?? {};
---

<Layout activePage="contact" title={t.meta.title} description={t.meta.description}>

  <div class="page-header container" style="position:relative;overflow:hidden">
    <span class="t-label">{t.header.label}</span>
    <h1>
      {t.header.titleLine1}<br /><em style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:300">{t.header.titleLine2}</em>
    </h1>
  </div>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="grid-2">

        <div>
          <h2 class="t-label" style="margin-bottom:28px">{t.form.label}</h2>

          <div id="contact-success" class="form-success" hidden role="status">
            <p class="form-success__title">{t.form.successTitle}</p>
            <p class="form-success__text">{t.form.successText}</p>
          </div>

          <form class="form-group" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action={localizePath('/contact', lang) + '?ok=1'}>
            <input type="hidden" name="form-name" value="contact" />
            <p hidden aria-hidden="true">
              <label>{t.form.honeypot} <input name="bot-field" /></label>
            </p>
            <div class="form-row">
              <div class="form-field">
                <label class="form-field__label" for="f-prenom">{t.form.prenomLabel}</label>
                <input id="f-prenom" type="text" name="prenom" placeholder={t.form.prenomPlaceholder} autocomplete="given-name" required />
              </div>
              <div class="form-field">
                <label class="form-field__label" for="f-nom">{t.form.nomLabel}</label>
                <input id="f-nom" type="text" name="nom" placeholder={t.form.nomPlaceholder} autocomplete="family-name" />
              </div>
            </div>
            <div class="form-field">
              <label class="form-field__label" for="f-email">{t.form.emailLabel}</label>
              <input id="f-email" type="email" name="email" placeholder={t.form.emailPlaceholder} autocomplete="email" required />
            </div>
            <div class="form-field">
              <label class="form-field__label" for="f-pratique">{t.form.pratiqueLabel}</label>
              <input id="f-pratique" type="text" name="pratique" placeholder={t.form.pratiquePlaceholder} />
            </div>
            <div class="form-field">
              <label class="form-field__label" for="f-message">{t.form.messageLabel}</label>
              <textarea id="f-message" name="message" rows="4" placeholder={t.form.messagePlaceholder}></textarea>
            </div>
            <div>
              <button type="submit" class="btn btn--dark">{t.form.submit}</button>
            </div>
          </form>
        </div>

        <div>
          <h2 class="t-label" style="margin-bottom:28px">{t.booking.label}</h2>

          <div style="position:relative;border-radius:6px;overflow:hidden;min-height:220px;margin-bottom:36px;background:#16066e">
            <div style="position:relative;padding:32px;color:#fff">
              <span style="font-family:'Tenor Sans',serif;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;opacity:0.85">{t.booking.eyebrow}</span>
              <h3 style="font-family:'Tenor Sans',serif;font-size:34px;line-height:1;margin:10px 0 14px;font-weight:400">{t.booking.title}</h3>
              <p style="font-size:14px;line-height:1.65;opacity:0.92;margin:0;max-width:340px">{t.booking.text}</p>
              <a href={PLANITY} target="_blank" rel="noopener" class="btn btn--outline-white" style="margin-top:22px">
                {c.cta.bookPlanity} →
              </a>
            </div>
          </div>

          <h2 class="t-label" style="margin-bottom:20px">{t.cabinet.label}</h2>
          <address style="font-style:normal">
            <p style="font-family:'Tenor Sans',serif;font-size:22px;line-height:1.4;margin:0 0 14px;font-weight:400">
              {t.cabinet.addressLine1}<br />{t.cabinet.addressLine2}
            </p>
            <p style="font-size:13.5px;line-height:1.85;color:rgba(13,10,31,0.55);margin:0">
              {t.cabinet.email}<br /><br />
              {t.cabinet.hours1}<br />
              {t.cabinet.hours2}<br />
              {t.cabinet.hours3}
            </p>
          </address>
        </div>

      </div>
    </div>
  </section>

  <section class="section--sm" style="padding-top:0">
    <div class="container">
      <div class="map-placeholder">
        <svg width="100%" height="100%" viewBox="0 0 900 300" style="position:absolute;inset:0" aria-hidden="true">
          <rect width="900" height="300" fill="#e8e3da" />
          <g stroke="rgba(13,10,31,0.12)" fill="none" stroke-width="1">
            {[...Array(12)].map((_, i) => (
              <line x1={0} x2={900} y1={i * 28} y2={i * 28} />
            ))}
            {[...Array(20)].map((_, i) => (
              <line x1={i * 50} x2={i * 50} y1={0} y2={300} />
            ))}
          </g>
          <path d="M 0 160 Q 225 140 450 180 T 900 160" stroke="rgba(255,113,0,0.4)" stroke-width="2" fill="none" />
          <circle cx="315" cy="158" r="12" fill="#ff7100" />
          <circle cx="315" cy="158" r="22" fill="rgba(255,113,0,0.2)" />
        </svg>
        <div style="position:absolute;bottom:20px;left:20px;background:#fff;padding:12px 18px;border-radius:4px;box-shadow:0 4px 20px rgba(0,0,0,0.08)">
          <span class="t-label" style="display:block;margin-bottom:4px">{t.map.label}</span>
          <span style="font-family:'Tenor Sans',serif;font-size:15px">{t.map.address}</span>
        </div>
      </div>
    </div>
  </section>

  <Faq items={t.faqs} title={c.faqTitle} />

  <Prose text={t.prose.text} label={t.prose.label} />

</Layout>

<style>
  .form-success {
    border-left: 2px solid var(--orange);
    background: rgba(255,113,0,0.06);
    padding: 22px 24px;
    border-radius: 0 4px 4px 0;
    margin-bottom: 8px;
    animation: pageIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .form-success__title {
    font-family: 'Tenor Sans', serif;
    font-size: 19px;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .form-success__text {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
    max-width: 44ch;
  }
</style>

<script is:inline>
  // Netlify renvoie vers /contact?ok=1 après envoi : on confirme et on masque le formulaire.
  if (new URLSearchParams(location.search).get('ok')) {
    const banner = document.getElementById('contact-success');
    const form = document.querySelector('form[name="contact"]');
    if (banner) {
      banner.hidden = false;
      banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    if (form) form.hidden = true;
  }
</script>
