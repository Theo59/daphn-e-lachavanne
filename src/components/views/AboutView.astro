---
/**
 * Vue partagée de la page « À propos ». Rendue à la fois pour `/about` (FR) et
 * `/en/about` (EN). Tout le texte vient du dictionnaire src/i18n/about.ts (+ common.ts).
 * Les routes (src/pages/about.astro, src/pages/en/about.astro) ne font que monter
 * cette vue avec la bonne langue.
 */
import Layout from '../../layouts/Layout.astro';
import Prose from '../Prose.astro';
import Faq from '../Faq.astro';
import { about } from '../../i18n/about';
import { common } from '../../i18n/common';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = about[lang];
const c = common[lang];

// Sources des images de la bande photo (données structurelles, identiques FR/EN).
const STRIP_PHOTOS = [
  { src: '/media/photo-1.jpg', alt: t.photos.alt1, style: 'filter:contrast(1.05) brightness(0.9)' },
  { src: '/media/6.jpg', alt: t.photos.alt2, style: 'filter:contrast(1.05) brightness(0.9)' },
  { src: '/media/9.jpg', alt: t.photos.alt3, style: 'filter:grayscale(1) contrast(0.95)' },
  { src: '/media/photo-3.jpg', alt: t.photos.alt4, style: 'filter:contrast(1.1) brightness(0.82)' },
];
---

<Layout activePage="about" title={t.meta.title} description={t.meta.description}>

  <!-- EN-TÊTE PORTRAIT -->
  <div class="page-header">
    <div class="container">
      <div class="grid-2" style="align-items:center">
        <div>
          <span class="t-label">{t.header.label}</span>
          <h1 style="font-size:clamp(64px,9vw,132px);margin-top:24px">
            {t.header.titleLine1}<br /><em style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:300">{t.header.titleLine2}</em>
          </h1>
          <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(18px,2vw,26px);line-height:1.4;font-weight:300;margin-top:32px;color:rgba(13,10,31,0.75)" set:html={t.header.subtitleHtml} />
        </div>
        <div class="photo-wrap" style="aspect-ratio:3/4;width:100%">
          <img src="/media/photo-1.jpg" alt={t.header.imgAlt} style="filter:contrast(1.05) brightness(0.9)" loading="eager" />
        </div>
      </div>
    </div>
  </div>

  <!-- HISTOIRE -->
  <section class="section">
    <div class="container">
      <div class="grid-label-content">
        <h2 class="t-label">{t.story.label}</h2>
        <div style="font-size:17px;line-height:1.85;color:#0d0a1f;max-width:640px">
          <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(20px,2.2vw,28px);line-height:1.4;font-weight:300;margin:0 0 24px">
            {t.story.lead}
          </p>
          <p style="margin:0 0 16px">
            {t.story.body1}
          </p>
          <p style="color:rgba(13,10,31,0.55);margin:0">
            {t.story.body2}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PARCOURS -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <h3 class="t-label" style="padding-bottom:20px;border-bottom:1px solid #0d0a1f;margin-bottom:0">{t.timeline.label}</h3>
      {t.timeline.items.map((row) => (
        <div class="timeline-row">
          <span class="timeline-row__year">{row.year}</span>
          <span class="timeline-row__event">{row.event}</span>
          <span class="timeline-row__place">{row.place}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- PHOTOS STRIP -->
  <section class="section--sm" style="padding-left:0;padding-right:0">
    <div class="photo-grid-4">
      {STRIP_PHOTOS.map((photo) => (
        <div class="photo-wrap" style="aspect-ratio:3/4;width:100%">
          <img src={photo.src} alt={photo.alt} style={photo.style} loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <!-- CITATION -->
  <section class="section" style="position:relative;overflow:hidden">
    <div style="position:absolute;inset:0;background:url('/media/fond-3.png') center/cover;opacity:0.35"></div>
    <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:70vw;max-width:700px;opacity:0.12;pointer-events:none">
      <img src="/media/cercle-trace.png" alt="" style="width:100%;display:block" />
    </div>
    <div class="container" style="position:relative;text-align:center">
      <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(24px,4vw,52px);line-height:1.25;font-weight:300;max-width:900px;margin:0 auto" set:html={t.quote.textHtml} />
      <p class="t-label" style="margin-top:28px">{t.quote.author}</p>
    </div>
  </section>

  <Prose text={t.prose.text} label={t.prose.label} />

  <Faq items={t.faqs} title={c.faqTitle} />

</Layout>
