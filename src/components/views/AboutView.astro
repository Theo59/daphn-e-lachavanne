---
/**
 * Vue partagée de la page « À propos ». Rendue à la fois pour `/about` (FR) et
 * `/en/about` (EN). Le contenu vient de Sanity au build (getPageContent/getSettings),
 * avec fallback sur src/i18n/about.ts. Les routes ne font que monter cette vue avec la bonne langue.
 */
import Layout from '../../layouts/Layout.astro';
import SanityImage from '../SanityImage.astro';
import MediaSlot from '../MediaSlot.astro';
import Prose from '../Prose.astro';
import Faq from '../Faq.astro';
import { getPageContent, getSettings } from '../../lib/sanity/content';
import { urlFor, hasImage } from '../../lib/sanity/image';
import { richTextToInlineHtml } from '../../lib/sanity/richText';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getPageContent('about', lang);
const c = await getSettings(lang);

// Images (champs Sanity, hors typage des dicos texte).
const headerImage = (t.header as any).image;
const photos = t.photos as any;
const brand = (c as any).brand ?? {};

// URL CDN pour les fonds CSS (vide si l'image n'est pas définie).
const bg = (img: unknown, w = 1600) => (hasImage(img) ? urlFor(img as any).width(w).url() : '');
const gradient2 = bg(brand.gradient2);

// Bande photo : image Sanity + alt (dico). Plus de filtre CSS : images affichées telles qu'uploadées dans Sanity.
const STRIP_PHOTOS = [
  { image: photos.image1, alt: t.photos.alt1, style: '', video: photos.image1Video },
  { image: photos.image2, alt: t.photos.alt2, style: '', video: photos.image2Video },
  { image: photos.image3, alt: t.photos.alt3, style: '', video: photos.image3Video },
  { image: photos.image4, alt: t.photos.alt4, style: '', video: photos.image4Video },
];
---

<Layout activePage="about" title={t.meta.title} description={t.meta.description}>

  <!-- EN-TÊTE PORTRAIT -->
  <div class="page-header">
    <div class="container">
      <div class="grid-2" style="align-items:center">
        <div>
          <span class="t-label">{t.header.label}</span>
          <h1 style="font-size:clamp(64px,9vw,132px);margin-top:24px">
            {t.header.titleLine1}<br /><em style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:300">{t.header.titleLine2}</em>
          </h1>
          <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(18px,2vw,26px);line-height:1.4;font-weight:300;margin-top:32px;color:rgba(13,10,31,0.75)" set:html={richTextToInlineHtml(t.header.subtitleHtml)} />
        </div>
        <div class="photo-wrap" style="aspect-ratio:3/4;width:100%">
          <MediaSlot image={headerImage} video={(t.header as any).video} alt={t.header.imgAlt} widths={[640, 1024]} sizes="(max-width:900px) 100vw, 50vw" loading="eager" />
        </div>
      </div>
    </div>
  </div>

  <!-- HISTOIRE -->
  <section class="section">
    <div class="container">
      <div class="grid-label-content">
        <h2 class="t-label">{t.story.label}</h2>
        <div style="font-size:17px;line-height:1.85;color:#0d0a1f;max-width:640px">
          <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(20px,2.2vw,28px);line-height:1.4;font-weight:300;margin:0 0 24px">
            {t.story.lead}
          </p>
          <p style="margin:0 0 16px">
            {t.story.body1}
          </p>
          <p style="color:rgba(13,10,31,0.55);margin:0">
            {t.story.body2}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PARCOURS -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <h3 class="t-label" style="padding-bottom:20px;border-bottom:1px solid #0d0a1f;margin-bottom:0">{t.timeline.label}</h3>
      {t.timeline.items.map((row) => (
        <div class="timeline-row">
          <span class="timeline-row__year">{row.year}</span>
          <span class="timeline-row__event">{row.event}</span>
          <span class="timeline-row__place">{row.place}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- PHOTOS STRIP -->
  <section class="section--sm" style="padding-left:0;padding-right:0">
    <div class="photo-grid-4">
      {STRIP_PHOTOS.map((photo) => (
        <div class="photo-wrap" style="aspect-ratio:3/4;width:100%">
          <MediaSlot image={photo.image} video={photo.video} alt={photo.alt} widths={[480, 768]} sizes="(max-width:900px) 50vw, 25vw" style={photo.style} loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </section>

  <!-- CITATION -->
  <section class="section" style="position:relative;overflow:hidden">
    <div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(700px,80vw);height:min(700px,80vw);opacity:0.07;pointer-events:none">
      <SanityImage image={brand.circle} alt="" width={700} style="width:100%;height:100%;object-fit:contain" />
    </div>
    <div class="container" style="position:relative;text-align:center">
      <p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(24px,4vw,52px);line-height:1.25;font-weight:300;max-width:900px;margin:0 auto" set:html={richTextToInlineHtml(t.quote.textHtml)} />
      <p class="t-label" style="margin-top:28px">{t.quote.author}</p>
    </div>
  </section>

  <Faq items={t.faqs} title={c.faqTitle} />

  <Prose text={t.prose.text} label={t.prose.label} />

</Layout>
