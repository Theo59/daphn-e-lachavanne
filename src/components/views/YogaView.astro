---
/**
 * Vue partagée de la page Yoga. Rendue à la fois pour `/yoga` (FR) et `/en/yoga` (EN).
 * Tout le texte vient du dictionnaire src/i18n/yoga.ts (+ common.ts).
 * Styles : classes scopées (<style>) ; fond du bloc tarif dynamique → inline.
 */
import Layout from '../../layouts/Layout.astro';
import SanityImage from '../SanityImage.astro';
import MediaSlot from '../MediaSlot.astro';
import Prose from '../Prose.astro';
import Faq from '../Faq.astro';
import { getPageContent, getSettings } from '../../lib/sanity/content';
import { PLANITY } from '../../lib/views';
import { localizePath } from '../../i18n/utils';
import { HTML_LANG, type Lang } from '../../i18n/config';
import { serviceLd } from '../../lib/schema.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getPageContent('yoga', lang);
const c = await getSettings(lang);

const serviceSchema = serviceLd({
  name: t.schema.name,
  serviceType: t.schema.serviceType,
  description: t.schema.description,
  path: localizePath('/yoga', lang),
  inLanguage: HTML_LANG[lang],
  offers: t.tarif.rows.map((r) => ({ name: r.title, price: r.price, description: r.detail })),
});
---

<Layout activePage="yoga" title={t.meta.title} description={t.meta.description} updatedAt={t._updatedAt} createdAt={t._createdAt}>

  <div class="page-header rel-clip">
    <div class="container rel">
      <span class="t-label">{t.header.label}</span>
      <h1>{t.header.h1}<em class="t-corm">.</em></h1>
      <div class="grid-2 header__grid">
        <p class="header__quote">{t.header.quote}</p>
        <p class="header__intro">{t.header.sub}</p>
      </div>
    </div>
  </div>

  <section class="section--sm">
    <div class="container">
      <div class="grid-3">
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.photos.image1} video={t.photos.image1Video} alt={t.photos.alt1} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.photos.image2} video={t.photos.image2Video} alt={t.photos.alt2} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.photos.image3} video={t.photos.image3Video} alt={t.photos.alt3} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="section pb0">
    <div class="container">
      <div class="grid-label-content">
        <div>
          <h2 class="t-label approche__label">{t.approche.label}</h2>
        </div>
        <div>
          <h3 class="approche__title">{t.approche.title}</h3>
        </div>
      </div>
    </div>
  </section>

  <div class="service-icon-section principles">
    <div class="service-icon-grid service-icon-grid--3 rel">
      {t.principles.map((pr) => (
        <div class="service-icon-card">
          <div class="service-icon-card__icon">
            <SanityImage image={(pr as { icon?: unknown }).icon} alt={pr.title} width={240} />
          </div>
          <div class="service-icon-card__meta">
            <h3 class="service-icon-card__name">{pr.title}</h3>
            <p class="service-icon-card__desc">{pr.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <section class="section section--dark tarif" style={`background:var(--${t.tarif.bgColor === 'orange' ? 'orange' : 'blue'})`}>
    <div class="container rel">
      <div class="grid-label-content">
        <div>
          <span class="tarif__label">{t.tarif.label}</span>
          <h3 class="tarif__title">{t.tarif.titleLine1}<br />{t.tarif.titleLine2}</h3>
          <p class="tarif__body">{t.tarif.body}</p>
          <a href={PLANITY} target="_blank" rel="noopener" class="btn btn--outline-white tarif__cta" data-umami-event="book_click" data-umami-event-location="yoga_tarif">{t.tarif.reserve}</a>
        </div>
        <div>
          {t.tarif.rows.map((r) => (
            <div class="tarif-row">
              <div>
                <h4 class="tarif-row__title">{r.title}</h4>
                <p class="tarif-row__detail">{r.detail}</p>
              </div>
              <div class="tarif-row__right">
                <span class="tarif-row__price">{r.price}</span>
                <a href={PLANITY} target="_blank" rel="noopener" class="reserve-link" data-umami-event="book_click" data-umami-event-location="yoga_row" data-umami-event-service={r.title}>{t.tarif.reserve}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Faq items={t.faqs} title={c.faqTitle} />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <Prose text={t.prose.text} label={t.prose.label} />

</Layout>

<style>
  /* Classes communes → src/styles/views.css. Ici : uniquement le spécifique. */
  .header__grid { margin-top: 44px; }
</style>
