---
/**
 * Vue partagée des mentions légales. Rendue pour `/mentions-legales` (FR) et
 * `/en/mentions-legales` (EN). Le contenu vient de Sanity au build (getPageContent),
 * avec fallback sur src/i18n/legal.ts. Les routes ne font que monter cette vue avec la bonne langue.
 */
import Layout from '../../layouts/Layout.astro';
import { getPageContent } from '../../lib/sanity/content';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getPageContent('legal', lang);
---

<Layout
  activePage=""
  title={t.meta.title}
  description={t.meta.description}
>
  <div class="page-header container">
    <span class="t-label">{t.label}</span>
    <h1>
      {t.titleLine1}<br /><em style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:300">{t.titleLine2}</em>
    </h1>
  </div>

  <section class="section" style="padding-top:0">
    <div class="container" style="max-width:760px;margin:0">
      {t.sections.map((s) => (
        <div style="margin-bottom:48px">
          <h2 class="t-label" style="margin-bottom:8px">( {s.title} )</h2>
          <dl style="margin:0;border-top:1px solid var(--rule)">
            {s.rows.map((r) => (
              <div style="display:grid;grid-template-columns:180px 1fr;gap:24px;padding:16px 0;border-bottom:1px solid var(--rule)">
                <dt style="font-family:'Tenor Sans',serif;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted)">{r.label}</dt>
                <dd style="margin:0;font-size:15px;line-height:1.6">{r.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}

      <div style="margin-bottom:48px">
        <h2 class="t-label" style="margin-bottom:16px">( {t.ipLabel} )</h2>
        <p style="font-size:15px;line-height:1.85;color:var(--ink)">{t.ipBody}</p>
      </div>

      <div>
        <h2 class="t-label" style="margin-bottom:16px">( {t.dataLabel} )</h2>
        <p style="font-size:15px;line-height:1.85;color:var(--ink)" set:html={t.dataBodyHtml} />
      </div>
    </div>
  </section>
</Layout>
