---
/**
 * Vue partagée de la page Soins. Rendue à la fois pour `/soins` (FR) et `/en/soins` (EN).
 * Tout le texte vient du dictionnaire src/i18n/soins.ts (+ common.ts).
 * Styles : classes scopées (<style>) ; fond des forfaits dynamique → inline.
 */
import Layout from '../../layouts/Layout.astro';
import Sym from '../Sym.astro';
import SanityImage from '../SanityImage.astro';
import MediaSlot from '../MediaSlot.astro';
import Prose from '../Prose.astro';
import Faq from '../Faq.astro';
import { getPageContent, getSettings } from '../../lib/sanity/content';
import { PLANITY } from '../../lib/views';
import { localizePath } from '../../i18n/utils';
import { serviceLd } from '../../lib/schema.ts';
import { HTML_LANG, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getPageContent('soins', lang);
const c = await getSettings(lang);

const serviceSchema = serviceLd({
  name: t.schema.name,
  serviceType: t.schema.serviceType,
  description: t.schema.description,
  path: localizePath('/soins', lang),
  inLanguage: HTML_LANG[lang],
  offers: [
    ...t.soins.map((s) => ({ name: s.name, price: s.price, description: s.sub })),
    ...t.packages.map((p) => ({ name: `${t.schema.packagePrefix} ${p.name}`, price: p.price, description: p.detail })),
  ],
});
---

<Layout activePage="soins" title={t.meta.title} description={t.meta.description}>

  <div class="page-header rel-clip">
    <div class="container rel">
      <span class="t-label">{t.header.label}</span>
      <h1>{t.header.h1}</h1>
      <div class="grid-2 header__grid">
        <p class="header__quote">{t.header.quote}</p>
        <div>
          <p class="header__intro">{t.header.intro}</p>
          <div class="header__method">
            <span class="t-label">{t.header.methodLabel}</span>
            <span class="header__rule"></span>
            <span class="t-label">{t.header.sinceLabel}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PHOTOS - 3 photos (cohérence avec les autres pratiques) -->
  <section class="section--sm">
    <div class="container">
      <div class="grid-3">
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.photo.image1} video={t.photo.image1Video} alt={t.photo.alt1} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.photo.image2} video={t.photo.image2Video} alt={t.photo.alt2} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.photo.image3} video={t.photo.image3Video} alt={t.photo.alt3} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- CATALOGUE - icon grid + soin-rows -->
  <section class="service-icon-section rel-clip">
    <div class="rel">
      <div class="container catalogue__head">
        <div class="catalogue__bar">
          <h2 class="t-label">{t.catalogue.label}</h2>
          <span class="catalogue__all">{t.catalogue.all}</span>
        </div>
      </div>
      <div class="service-icon-grid">
        {t.soins.map((s) => (
          <div class="service-icon-card">
            <div class="service-icon-card__icon">
              <SanityImage image={(s as { icon?: unknown }).icon} alt={s.name} width={240} />
            </div>
            <div class="service-icon-card__meta">
              <h3 class="service-icon-card__name">{s.name}</h3>
              <p class="service-icon-card__sub">{s.sub}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="container catalogue__rows">
        {t.soins.map((s, i) => (
          <article class="soin-row">
            <span class="soin-row__num">0{i + 1}</span>
            <div>
              <h3 class="soin-row__name">{s.name}</h3>
              <p class="soin-row__sub">{s.sub}</p>
            </div>
            <p class="soin-row__text">{s.text}</p>
            <div class="soin-row__price">
              <span class="soin-row__price-val">{s.price}</span>
              <a href={PLANITY} target="_blank" rel="noopener" class="link-arrow reserve-sm">{t.catalogue.reserve}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FORFAITS -->
  <section class="section pt0 packages-section">
    <div class="container">
      <h3 class="t-label packages__label">{t.packagesLabel}</h3>
      <div class="grid-3">
        {t.packages.map((p) => (
          <div class="forfait" style={`background:var(--${t.packagesBgColor === 'blue' ? 'blue' : 'orange'})`}>
            <div class="forfait__content">
              <div>
                <h4 class="forfait__name">{p.name}</h4>
                <p class="forfait__detail">{p.detail}</p>
              </div>
              <div class="forfait__bottom">
                <span class="forfait__price">{p.price}</span>
                <Sym kind="arrow" size={20} color="#fff" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Faq items={t.faqs} title={c.faqTitle} />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <Prose text={t.prose.text} label={t.prose.label} />

</Layout>

<style>
  /* Classes communes → src/styles/views.css. Ici : uniquement le spécifique. */
  /* En-tête (margin-top 48px, différent des autres pratiques → reste local) */
  .header__grid { margin-top: 48px; }
  .header__method { margin-top: 20px; display: flex; align-items: center; gap: 16px; }
  .header__rule { width: 28px; height: 1px; background: rgba(13, 10, 31, 0.4); display: inline-block; }

  /* Catalogue */
  .catalogue__head { padding-top: 56px; padding-bottom: 40px; }
  .catalogue__bar { display: flex; justify-content: space-between; align-items: baseline; }
  .catalogue__all { font-size: 13px; color: var(--muted); }
  .catalogue__rows { padding-top: 0; padding-bottom: 0; }
  .reserve-sm { font-size: 10px; }

  /* Forfaits (fond dynamique → inline) */
  .packages-section { padding-bottom: 2rem; }
  .packages__label { margin-top: 56px; margin-bottom: 32px; }
</style>
