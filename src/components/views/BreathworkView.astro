---
/**
 * Vue partagée de la page Breathwork. Rendue pour /breathwork (FR) et /en/breathwork (EN).
 * Tout le texte vient de src/i18n/breathwork.ts (+ common.ts).
 * Styles : classes scopées (<style>) ; fond du bloc tarif dynamique → inline.
 */
import Layout from '../../layouts/Layout.astro';
import Prose from '../Prose.astro';
import SanityImage from '../SanityImage.astro';
import MediaSlot from '../MediaSlot.astro';
import Faq from '../Faq.astro';
import { getPageContent, getSettings } from '../../lib/sanity/content';
import { PLANITY } from '../../lib/views';
import { richTextToInlineHtml } from '../../lib/sanity/richText';
import { localizePath } from '../../i18n/utils';
import { serviceLd } from '../../lib/schema.ts';
import { HTML_LANG, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = await getPageContent('breathwork', lang);
const c = await getSettings(lang);

const serviceSchema = serviceLd({
  name: t.schema.name,
  serviceType: t.schema.serviceType,
  description: t.schema.description,
  path: localizePath('/breathwork', lang),
  inLanguage: HTML_LANG[lang],
  offers: t.tarifs.map((tf) => ({ name: tf.title, price: tf.price, description: tf.detail })),
});
---

<Layout activePage="breathwork" title={t.meta.title} description={t.meta.description}>

  <div class="page-header rel-clip">
    <div class="container rel">
      <span class="t-label">{t.header.label}</span>
      <h1>{t.header.title}<em class="t-corm">.</em></h1>
      <div class="grid-2 header__grid">
        <p class="header__quote">{t.header.quote}</p>
        <p class="header__intro">{t.header.sub}</p>
      </div>
    </div>
  </div>

  <section class="section--sm">
    <div class="container">
      <div class="grid-3">
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.gallery.photo1} video={t.gallery.photo1Video} alt={t.gallery.photo1Alt} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.gallery.photo2} video={t.gallery.photo2Video} alt={t.gallery.photo2Alt} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
        <div class="photo-wrap photo-portrait">
          <MediaSlot image={t.gallery.photo3} video={t.gallery.photo3Video} alt={t.gallery.photo3Alt} widths={[480, 768]} sizes="(max-width:900px) 100vw, 33vw" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="section pb0">
    <div class="container">
      <div class="grid-label-content">
        <div>
          <h2 class="t-label approche__label">{t.approach.label}</h2>
        </div>
        <div>
          <h3 class="approche__title">{t.approach.title}</h3>
        </div>
      </div>
    </div>
  </section>

  <div class="service-icon-section principles">
    <div class="service-icon-grid service-icon-grid--3 rel">
      {t.principles.map((pr) => (
        <div class="service-icon-card">
          <div class="service-icon-card__icon">
            <SanityImage image={(pr as { icon?: unknown }).icon} alt={pr.title} width={240} />
          </div>
          <div class="service-icon-card__meta">
            <h3 class="service-icon-card__name">{pr.title}</h3>
            <p class="service-icon-card__desc">{pr.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <section class="section section--dark tarif" style={`background:var(--${t.pricing.bgColor === 'orange' ? 'orange' : 'blue'})`}>
    <div class="container rel">
      <div class="grid-label-content">
        <div>
          <span class="tarif__label">{t.pricing.label}</span>
          <h3 class="tarif__title" set:html={richTextToInlineHtml(t.pricing.titleHtml)} />
          <p class="tarif__body">{t.pricing.text}</p>
          <a href={PLANITY} target="_blank" rel="noopener" class="btn btn--outline-white tarif__cta">{t.pricing.book}</a>
        </div>
        <div>
          {t.tarifs.map((tf) => (
            <div class="tarif-row">
              <div>
                <h4 class="tarif-row__title">{tf.title}</h4>
                <p class="tarif-row__detail">{tf.detail}</p>
              </div>
              <div class="tarif-row__right">
                <span class="tarif-row__price">{tf.price}</span>
                <a href={PLANITY} target="_blank" rel="noopener" class="reserve-link">{t.pricing.book}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Faq items={t.faqs} title={c.faqTitle} />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <Prose text={t.prose.text} label={t.prose.label} />

</Layout>

<style>
  /* Classes communes → src/styles/views.css. Ici : uniquement le spécifique. */
  .header__grid { margin-top: 44px; }
</style>
