---
/**
 * <Picture> — sert les médias optimisés (`public/media/web/`, générés par
 * `npm run media`) avec négociation de format : AVIF → WebP → format d'origine.
 *
 * Usage : on passe `src` comme un chemin `/media/…` d'origine ; le composant
 * pointe automatiquement vers les variantes générées. Tout le reste
 * (`style`, `class`, `loading`, `fetchpriority`, `decoding`, `width`,
 * `height`, `aria-*`…) est transmis tel quel à la balise <img>.
 *
 * `display:contents` sur <picture> : la balise ne crée aucun box, donc la <img>
 * conserve exactement la mise en page d'origine (width:100%, object-fit,
 * position:absolute, filtres CSS…). Drop-in pour remplacer un `<img src="/media/…">`.
 *
 * Repli : si `src` n'est pas un média optimisable (URL externe, format inconnu),
 * on rend une <img> simple inchangée.
 */
interface Props {
  src: string;
  alt?: string;
  [key: string]: unknown;
}
const { src, alt = '', ...rest } = Astro.props;

const m = /^\/media\/(.+)\.(avif|webp|png|jpe?g)$/i.exec(src);
const name = m?.[1];
const ext = m?.[2]?.toLowerCase();
const fallbackExt = ext === 'jpeg' ? 'jpg' : ext;
const webBase = name ? `/media/web/${name}` : null;
---

{webBase ? (
  <picture style="display:contents">
    <source srcset={`${webBase}.avif`} type="image/avif" />
    <source srcset={`${webBase}.webp`} type="image/webp" />
    <img src={`${webBase}.${fallbackExt}`} alt={alt} {...rest} />
  </picture>
) : (
  <img src={src} alt={alt} {...rest} />
)}
